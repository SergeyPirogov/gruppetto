<workout_file>
    <author>Gruppetto</author>
    <name>ERG check: 120-160-200-240 W</name>
    <description>The same workout in Gruppetto and in Zwift to compare power and heart rate. Ride both on a warm trainer, same fan, same time of day. Absolute watts, so set FTP to 200 W in both apps.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.60"/>
        <SteadyState Duration="300" Power="0.60"/>
        <SteadyState Duration="300" Power="0.80"/>
        <SteadyState Duration="300" Power="1.00"/>
        <SteadyState Duration="300" Power="1.20"/>
        <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.30"/>
    </workout>
</workout_file>
